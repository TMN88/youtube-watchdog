#!/bin/sh
. /usr/share/libubox/jshn.sh
reply() { json_init; json_add_boolean ok "$1"; [ -z "${2:-}" ] || json_add_string message "$2"; json_dump; }
case "$1" in
    list) echo '{"status":{},"logs":{},"start":{},"stop":{},"restart":{},"enable":{},"disable":{},"check":{},"set_interval":{"minutes":0}}' ;;
    call)
        # Only fixed actions and a validated integer interval are accepted.
        read -r input
        case "$2" in
            status|logs) exec /usr/bin/youtube-watchdog "$2" ;;
            start|stop|restart|enable|disable)
                if /etc/init.d/youtube-watchdog "$2" >/dev/null 2>&1; then reply 1; else reply 0; fi ;;
            check)
                mkdir -p /tmp/youtube-watchdog
                if ! flock -n /tmp/youtube-watchdog/operation.lock true 2>/dev/null; then reply 0; exit 0; fi
                /usr/bin/youtube-watchdog check </dev/null >/dev/null 2>&1 &
                reply 1 ;;
            set_interval)
                json_load "$input" || { reply 0 'Некорректный запрос'; exit 0; }
                json_get_type value_type minutes
                json_get_var minutes minutes
                if [ "$value_type" != int ]; then reply 0 'Выберите интервал из списка'; exit 0; fi
                case "$minutes" in 1|3|5|7|10|15|20|30) ;; *) reply 0 'Допустимые интервалы: 1, 3, 5, 7, 10, 15, 20, 30 минут'; exit 0 ;; esac
                mkdir -p /tmp/youtube-watchdog || { reply 0 'Не удалось сохранить настройки'; exit 0; }
                exec 7>/tmp/youtube-watchdog/settings.lock
                flock -n 7 || { reply 0 'Настройки уже сохраняются'; exit 0; }
                seconds=$((minutes * 60))
                if ! uci -q get youtube-watchdog.main >/dev/null 2>&1; then reply 0 'Не найдена конфигурация Watchdog'; exit 0; fi
                if [ "$(uci -q get youtube-watchdog.main.interval 2>/dev/null)" = "$seconds" ]; then reply 1; exit 0; fi
                if uci set "youtube-watchdog.main.interval=$seconds" && uci commit youtube-watchdog; then
                    if touch /tmp/youtube-watchdog/interval.changed; then reply 1; else reply 0 'Интервал сохранён; не удалось уведомить службу'; fi
                else
                    reply 0 'Не удалось сохранить интервал'
                fi ;;
            *) exit 1 ;;
        esac ;;
    *) exit 1 ;;
esac
